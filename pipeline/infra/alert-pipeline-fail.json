{
  "displayName": "pipeline_fail",
  "documentation": {
    "content": "nsm-job 파이프라인 실패 감지",
    "mimeType": "text/markdown"
  },
  "combiner": "OR",
  "conditions": [
    {
      "displayName": "nsm-job status=fail",
      "conditionMatchedLog": {
        "filter": "resource.type=\"cloud_run_job\" resource.labels.job_name=\"nsm-job\" jsonPayload.status=\"fail\""
      }
    }
  ],
  "alertStrategy": {
    "notificationRateLimit": { "period": "300s" },
    "autoClose": "3600s"
  },
  "notificationChannels": ["__CHANNEL_ID__"],
  "enabled": true,
  "severity": "CRITICAL"
}
